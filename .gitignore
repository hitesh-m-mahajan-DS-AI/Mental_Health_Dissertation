# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
tmp/

# Local editor and OS state
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets and machine-local configuration
.env
.env.*
*.key
*.pem

# Frozen research datasets are local inputs. Public redistribution requires
# an explicit licence/privacy decision.
*.csv

# Model checkpoints are local-only. GitHub rejects normal files over 100 MiB,
# and several checkpoint shards exceed the GitHub Free LFS per-file limit.
model/
*.safetensors
*.pth
*.pt
*.bin
*.gguf

# Generated activations, temporary offload weights, logs, and other outputs.
results/**
!results/activations/
results/activations/**
!results/activations/metadata/
results/activations/metadata/**
!results/activations/metadata/checkpoint_report_*.md
!results/probes/
!results/probes/**
!results/causal_patching/
results/causal_patching/**
!results/causal_patching/metadata/
!results/causal_patching/metadata/*.json
!results/causal_patching/motivation/
!results/causal_patching/motivation/metadata/
!results/causal_patching/motivation/metadata/*.jsonl
!results/causal_patching/empathy/
!results/causal_patching/empathy/metadata/
!results/causal_patching/empathy/metadata/*.jsonl
!results/causal_patching/metadata/*.md
!results/causal_patching/motivation/*.json
!results/causal_patching/motivation/*.png
!results/causal_patching/empathy/*.json
!results/causal_patching/empathy/*.png
logs/
*.log

