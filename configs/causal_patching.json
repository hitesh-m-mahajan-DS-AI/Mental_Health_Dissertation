{
  "project_root": "..",
  "model_path": "model",
  "motivation_csv": "annomi_motivation_final_candidate_v3_2.csv",
  "empathy_csv": "MHLCD.csv",
  "activation_run_id": "20260817T181608Z",
  "output_root": "results/causal_patching",
  "offload_dir": "results/model_offload",
  "dtype": "bfloat16",
  "device_map": "auto",
  "max_memory": {"0": "6800MiB", "cpu": "2GiB"},
  "max_length": 128,
  "datasets": ["motivation", "empathy"],
  "pair_construction": "controlled_instruction_counterfactual",
  "task_styles": {
    "motivation": {"clean": "motivational", "corrupted": "neutral"},
    "empathy": {"clean": "compassionate", "corrupted": "neutral"}
  },
  "supportive_target": " I",
  "neutral_target": " Okay",
  "prompt_template": "Instruction: Give a {style} counsellor response.\nClient: {context}\nCounsellor:",
  "patch_activation": "residual_pre",
  "patch_positions": "final_valid_prompt_token",
  "sensitivity_patch_positions": "controlled_instruction_token_only_on_candidate_layers",
  "score_position": "first_generated_response_position",
  "faithfulness_equation": "(patched-corrupted)/(clean-corrupted)",
  "zero_denominator_epsilon": 1e-6,
  "bootstrap_resamples": 1000,
  "bootstrap_seed": 42,
  "candidate_layer_rule": "positive_mean_effect_and_bootstrap_95ci_excludes_zero",
  "completeness_random_subsets": 100,
  "minimality_threshold_fraction_full_model": 0.01,
  "batch_size": 4,
  "smoke_test_pairs_per_dataset": 1
}
